# ==============================================================================
# AlphaQuant 环境变量配置模板
# 使用说明：将此文件复制并重命名为 `.env`，然后填入您真实的 API 密钥等配置
# 注意：切勿将包含真实密钥的 `.env` 提交到 GitHub 仓库！
# ==============================================================================

# 系统运行环境
ENV=development
DEBUG=true

# 数据库配置
# 默认使用本地 SQLite 数据库，若使用 PostgreSQL，请修改连接串
DATABASE_URL=sqlite:///./data/alpha_quant.db

# 数据源 API 配置
# 例如：Tushare token (中国A股数据源)，Binance API Key (加密货币数据源)
TUSHARE_TOKEN=your_tushare_token_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# 交易执行 API 配置 (模拟/实盘)
TRADE_API_KEY=your_trading_api_key_here
TRADE_API_SECRET=your_trading_api_secret_here

# 后端 Web API 配置
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 密钥（用于 JWT 验证等安全加密，生产环境必须更改）
SECRET_KEY=alpha_quant_secure_secret_key_change_me_in_production
